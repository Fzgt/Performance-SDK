{
  "name": "performance-sdk",
  "version": "1.0.0",
  "description": "A frontend performance monitoring SDK written in TypeScript, capturing Web Vitals and page-load timing breakdowns with prioritised reporting.",
  "main": "dist/index.js",
  "source": "src/index.ts",
  "module": "dist/index.module.js",
  "types": "dist/typings/index.d.ts",
  "unpkg": "dist/index.umd.js",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "microbundle",
    "dev": "microbundle watch",
    "test": "jest",
    "example:run": "parcel examples/index.html",
    "api:init": "api-extractor init",
    "api:run": "api-extractor run --local --verbose",
    "api:doc": "typedoc --out docs src",
    "prepublishOnly": "yarn build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "performance",
    "web-vitals",
    "monitoring",
    "typescript",
    "sdk"
  ],
  "author": "Fzgt",
  "license": "ISC",
  "devDependencies": {
    "@microsoft/api-extractor": "^7.12.1",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "microbundle": "^0.15.1",
    "parcel-bundler": "^1.12.4",
    "ts-jest": "^29.4.12",
    "typedoc": "^0.20.9",
    "typescript": "^4.9.5"
  }
}
